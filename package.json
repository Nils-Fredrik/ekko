{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "ekko",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js && prettier --check resources/js",
        "format": "prettier --write resources/js && eslint --fix resources/js",
        "test:browser": "playwright test",
        "test:ui": "node scripts/ui-quality/run.mjs",
        "test:ui:update": "node scripts/ui-quality/run.mjs --update-snapshots",
        "test:ui:contracts": "node --test tests/ui-quality/*.test.mjs",
        "test:budget": "node scripts/ui-quality/budget.mjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@eslint/js": "^9.39.5",
        "@inertiajs/vue3": "^2.0",
        "@playwright/test": "1.65.1",
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.10",
        "@tailwindcss/vite": "^4.3.5",
        "@vitejs/plugin-vue": "^6.0.4",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.1",
        "globals": "^17.14.0",
        "js-yaml": "^4.3.2",
        "laravel-vite-plugin": "^2.0.0",
        "pixelmatch": "7.1.0",
        "pngjs": "7.0.0",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.3.5",
        "vite": "^7.0.7",
        "vue": "^3.3.13"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@heroicons/vue": "^2.2.0",
        "@tanstack/vue-table": "^9.3.1",
        "@tanstack/vue-virtual": "^3.13.52",
        "echarts": "^6.1.0",
        "laravel-vue-i18n": "^2.9.0"
    }
}
