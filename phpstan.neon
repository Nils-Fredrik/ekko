includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # Per-worktree cache: the default system temp folder is shared by all worktrees on a machine and
    # can point a run at another worktree's files, which crashes the analysis.
    tmpDir: storage/framework/cache/phpstan
    paths:
        - app
        - config
        - database
        - routes
        - tests/Fixtures
