APP_NAME=Ekko
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Per agent (AGENTS.md): Claude Code 8001, Cursor 8002, Codex 8003
APP_PORT=8001
# php artisan serve (and composer dev) reads SERVER_PORT from this file.
SERVER_PORT="${APP_PORT}"
APP_URL=http://localhost:8001

APP_LOCALE=nb
APP_FALLBACK_LOCALE=nb
APP_FAKER_LOCALE=nb_NO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Per agent (AGENTS.md): ekko_claude, ekko_cursor, ekko_codex. Tests use DB_TEST_DATABASE.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ekko_claude
DB_TEST_DATABASE=ekko_claude_testing
DB_USERNAME=postgres
DB_PASSWORD=
# Row-level security (docs/spec.md 5.3): requests and jobs run as this role. No superuser, no BYPASSRLS.
DB_RLS_ROLE=ekko_app
# Platform admin actions only: a role with BYPASSRLS. Empty means the DB_USERNAME login (local only).
DB_ADMIN_USERNAME=
DB_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Per agent (AGENTS.md): ekko_claude_session, ekko_cursor_session, ekko_codex_session.
# Browsers do not separate cookies by port, so worktrees on localhost need different names.
SESSION_COOKIE=ekko_claude_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Per agent (AGENTS.md): Claude Code 5174, Cursor 5175, Codex 5176
VITE_PORT=5174

# Single sign-on with Google (docs/spec.md 5.4). Empty = hidden. Redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic workspace key for model-based extraction (docs/spec.md 12.5). Never committed.
ANTHROPIC_API_KEY=

OPENAI_CHATGPT_MODEL=gpt-5-mini
