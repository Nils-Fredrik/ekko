# Inactive job fragment, to be integrated into CI only after T10 is complete.
# test and image are existing jobs in .github/workflows/ci.yml.
  deploy:
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    needs: [test, image]
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    concurrency:
      group: production-deploy
      cancel-in-progress: false
    env:
      PROJECT_ID: ekko-514612
      REGION: europe-west1
      WEB_TAG: europe-west1-docker.pkg.dev/ekko-514612/ekko/web:${{ github.sha }}
      JOB_TAG: europe-west1-docker.pkg.dev/ekko-514612/ekko/jobs:${{ github.sha }}
      REVISION_SUFFIX: r${{ github.run_id }}-${{ github.run_attempt }}
    steps:
      - uses: actions/checkout@v4
      - id: auth
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ vars.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ekko-ci@ekko-514612.iam.gserviceaccount.com
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
      - run: npm ci --no-audit --no-fund
      - run: npx playwright install --with-deps chromium
      - uses: google-github-actions/setup-gcloud@v2
      - run: gcloud auth configure-docker europe-west1-docker.pkg.dev --quiet
      - uses: docker/setup-buildx-action@v3
      - id: web
        uses: docker/build-push-action@v6
        with:
          context: .
          target: web
          push: true
          tags: ${{ env.WEB_TAG }}
      - id: jobs
        uses: docker/build-push-action@v6
        with:
          context: .
          target: jobs
          push: true
          tags: ${{ env.JOB_TAG }}
      - name: Deploy candidate and promote after smoke test
        env:
          SMOKE_EMAIL: ${{ secrets.SMOKE_EMAIL }}
          SMOKE_PASSWORD: ${{ secrets.SMOKE_PASSWORD }}
          SMOKE_REST_TOKEN: ${{ secrets.SMOKE_REST_TOKEN }}
          SMOKE_TENANT_ID: ${{ vars.SMOKE_TENANT_ID }}
          SMOKE_BRAND_ID: ${{ vars.SMOKE_BRAND_ID }}
          SMOKE_MCP_CLIENT_ID: ${{ vars.SMOKE_MCP_CLIENT_ID }}
          WEB_IMAGE: europe-west1-docker.pkg.dev/ekko-514612/ekko/web@${{ steps.web.outputs.digest }}
          JOB_IMAGE: europe-west1-docker.pkg.dev/ekko-514612/ekko/jobs@${{ steps.jobs.outputs.digest }}
        run: scripts/deploy.sh
